# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase: public (sent to the browser; RLS is the guard) ---
NEXT_PUBLIC_SUPABASE_URL=https://wzpgivhhepjpzvdnlbmf.supabase.co
# Use the new publishable key (sb_publishable_...). Dashboard: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server only (NEVER prefix with NEXT_PUBLIC_) ---
# New secret key (sb_secret_...). Not needed until later milestones.
SUPABASE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Bangkok

# --- Gemini AI (server only). AI Studio API key, NOT Vertex. ---
# Get a key at https://aistudio.google.com/apikey. For the FREE tier, create it
# in a Google Cloud project with NO billing attached.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_ESCALATION=gemini-2.5-flash

