# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase: public (sent to the browser; RLS is the guard) ---
NEXT_PUBLIC_SUPABASE_URL=https://wzpgivhhepjpzvdnlbmf.supabase.co
# Use the new publishable key (sb_publishable_...). Dashboard: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server only (NEVER prefix with NEXT_PUBLIC_) ---
